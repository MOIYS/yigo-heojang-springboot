{
  "info": {
    "_postman_id": "1e62d155-5a72-48f1-b5e6-014bbfe94ea3",
    "name": "yigo-heojang Legacy API Regression",
    "description": "현재 Spring Legacy API 동작을 변경 없이 고정하는 특성 테스트입니다. 동적 ID, JWT, 시각은 값 자체가 아니라 존재 여부와 형식만 검증합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "signupTermsAgreements", "value": "[]" },
    { "key": "signupMemberId", "value": "" },
    { "key": "userCardId", "value": "" },
    { "key": "notificationReadId", "value": "" },
    { "key": "notificationDeleteId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Auth and Health",
      "item": [
        {
          "name": "회원가입 약관 조회",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/terms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200과 공통 성공 응답을 반환한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.code).to.eql('SUCCESS');",
                  "  pm.expect(body.data.terms).to.be.an('array').that.is.not.empty;",
                  "  const agreements = body.data.terms.map(function (term) {",
                  "    pm.expect(term.termsVersionId).to.be.a('number').and.above(0);",
                  "    return { termsVersionId: term.termsVersionId, agreed: term.required === true };",
                  "  });",
                  "  pm.collectionVariables.set('signupTermsAgreements', JSON.stringify(agreements));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "회원가입",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"Password123!\",\n  \"name\": \"Newman Signup\",\n  \"signupVerificationToken\": \"{{signupVerificationToken}}\",\n  \"termsAgreements\": {{signupTermsAgreements}}\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201과 회원 계약을 반환한다', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.code).to.eql('SUCCESS');",
                  "  pm.expect(body.data.memberId).to.be.a('number').and.above(0);",
                  "  pm.expect(body.data.email).to.eql(pm.variables.get('signupEmail'));",
                  "  pm.expect(body.data.memberStatus).to.eql('ACTIVE');",
                  "  pm.expect(Array.isArray(body.data.createdAt)).to.eql(true);",
                  "  pm.expect(body.data.createdAt.length).to.be.within(5, 7);",
                  "  pm.expect(body.data.createdAt.every(Number.isInteger)).to.eql(true);",
                  "  pm.collectionVariables.set('signupMemberId', String(body.data.memberId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "잘못된 로그인",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 LOGIN_CREDENTIAL_MISMATCH를 반환한다', function () {",
                  "  pm.response.to.have.status(401);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.code).to.eql('LOGIN_CREDENTIAL_MISMATCH');",
                  "  pm.expect(body.message).to.eql('아이디 또는 비밀번호가 일치하지 않습니다.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "로그인",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code !== 200) {",
                  "  pm.collectionVariables.unset('accessToken');",
                  "  pm.collectionVariables.unset('refreshToken');",
                  "  pm.execution.setNextRequest(null);",
                  "}",
                  "pm.test('Access Token과 HttpOnly Refresh Token 쿠키를 발급한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.code).to.eql('SUCCESS');",
                  "  pm.expect(body.data.accessToken).to.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/);",
                  "  pm.expect(body.data.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.data.expiresIn).to.be.a('number').and.above(0);",
                  "  pm.expect(body.data).not.to.have.property('refreshToken');",
                  "  pm.expect(body.data.member.email).to.eql(pm.variables.get('memberEmail'));",
                  "  const setCookie = pm.response.headers.get('Set-Cookie');",
                  "  pm.expect(setCookie).to.include('refreshToken=');",
                  "  pm.expect(setCookie).to.include('HttpOnly');",
                  "  pm.expect(setCookie).to.include('Path=/');",
                  "  pm.expect(setCookie).to.include('Max-Age=43200');",
                  "  pm.expect(setCookie).to.include('SameSite=Lax');",
                  "  pm.expect(setCookie).not.to.include('Secure');",
                  "  const match = setCookie.match(/(?:^|;\\s*)refreshToken=([^;]+)/);",
                  "  pm.expect(match).not.to.eql(null);",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', match[1]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[legacy] Health - 토큰 없음 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[legacy] Health도 JWT 필터 보호를 받아 401을 반환한다', function () {",
                  "  pm.response.to.have.status(401);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.code).to.eql('ACCESS_TOKEN_INVALID');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[legacy] Health - 토큰 있음 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[legacy] 유효한 Access Token으로 Health가 성공한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.code).to.eql('SUCCESS');",
                  "  pm.expect(body.message).to.eql(null);",
                  "  pm.expect(body.data).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[legacy] 토큰 재발급 - Refresh Token 비회전",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "refreshToken={{refreshToken}}" }],
            "url": "{{baseUrl}}/api/auth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[legacy] Access Token만 반환하고 Refresh Token을 회전하지 않는다', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.accessToken).to.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/);",
                  "  pm.expect(body.data.tokenType).to.eql('Bearer');",
                  "  pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false);",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[legacy] 토큰 재발급 - 동일 Refresh Token 재사용",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "refreshToken={{refreshToken}}" }],
            "url": "{{baseUrl}}/api/auth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[legacy] 동일 Refresh Token을 다시 사용할 수 있다', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.accessToken).to.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/);",
                  "  pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false);",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Member",
      "item": [
        {
          "name": "Access Token 없음",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/members/me"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('보호 API는 401 ACCESS_TOKEN_INVALID를 반환한다', function () {",
            "  pm.response.to.have.status(401);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(false);",
            "  pm.expect(body.code).to.eql('ACCESS_TOKEN_INVALID');",
            "});"
          ] } }]
        },
        {
          "name": "회원 조회",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/members/me" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('회원 정보와 해시 비노출 계약을 반환한다', function () {",
            "  pm.response.to.have.status(200);",
            "  const data = pm.response.json().data;",
            "  pm.expect(data.memberId).to.be.a('number').and.above(0);",
            "  pm.expect(data.email).to.eql(pm.variables.get('memberEmail'));",
            "  pm.expect(data.simplePasswordSet).to.be.a('boolean');",
            "  pm.expect(data.memberStatus).to.eql('ACTIVE');",
            "  pm.expect(data).not.to.have.property('password');",
            "  pm.expect(data).not.to.have.property('passwordHash');",
            "  pm.expect(data).not.to.have.property('simplePasswordHash');",
            "  pm.expect(Array.isArray(data.createdAt)).to.eql(true);",
            "  pm.expect(data.createdAt.length).to.be.within(5, 7);",
            "  pm.expect(data.createdAt.every(Number.isInteger)).to.eql(true);",
            "});"
          ] } }]
        },
        {
          "name": "회원 수정",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nickname\": \"newman-updated-{{runId}}\"\n}" },
            "url": "{{baseUrl}}/api/members/me"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('수정된 닉네임을 포함한 회원 정보를 반환한다', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(true);",
            "  pm.expect(body.data.nickname).to.eql('newman-updated-' + pm.variables.get('runId'));",
            "  pm.expect(Array.isArray(body.data.updatedAt)).to.eql(true);",
            "  pm.expect(body.data.updatedAt.length).to.be.within(5, 7);",
            "  pm.expect(body.data.updatedAt.every(Number.isInteger)).to.eql(true);",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "03 Card",
      "item": [
        {
          "name": "카드 등록",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cardNumber\": \"{{cardNumber}}\"\n}" },
            "url": "{{baseUrl}}/api/user-cards"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201과 마스킹된 카드 정보를 반환한다', function () {",
            "  pm.response.to.have.status(201);",
            "  const data = pm.response.json().data;",
            "  pm.expect(data.userCardId).to.be.a('number').and.above(0);",
            "  pm.expect(data.cardId).to.be.a('number').and.above(0);",
            "  pm.expect(data.maskedCardNumber).to.be.a('string').and.not.eql(pm.variables.get('cardNumber'));",
            "  pm.expect(data.representative).to.eql(false);",
            "  pm.collectionVariables.set('userCardId', String(data.userCardId));",
            "});"
          ] } }]
        },
        {
          "name": "카드 목록 조회",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/user-cards" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('등록 카드가 목록에 포함된다', function () {",
            "  pm.response.to.have.status(200);",
            "  const data = pm.response.json().data;",
            "  pm.expect(data.userCards).to.be.an('array');",
            "  pm.expect(data.totalCount).to.eql(data.userCards.length);",
            "  const item = data.userCards.find(card => String(card.userCardId) === pm.collectionVariables.get('userCardId'));",
            "  pm.expect(item).not.to.eql(undefined);",
            "  pm.expect(Array.isArray(item.registeredAt)).to.eql(true);",
            "  pm.expect(item.registeredAt.length).to.be.within(5, 7);",
            "  pm.expect(item.registeredAt.every(Number.isInteger)).to.eql(true);",
            "});"
          ] } }]
        },
        {
          "name": "카드 상세 조회",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/user-cards/{{userCardId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('등록 카드 상세를 반환한다', function () {",
            "  pm.response.to.have.status(200);",
            "  const data = pm.response.json().data;",
            "  pm.expect(String(data.userCardId)).to.eql(pm.collectionVariables.get('userCardId'));",
            "  pm.expect(data.maskedCardNumber).not.to.eql(pm.variables.get('cardNumber'));",
            "});"
          ] } }]
        },
        {
          "name": "존재하지 않는 카드 조회",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/user-cards/0" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 USER_CARD_NOT_FOUND를 반환한다', function () {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().code).to.eql('USER_CARD_NOT_FOUND');",
            "});"
          ] } }]
        },
        {
          "name": "대표카드 설정",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"representative\": true\n}" },
            "url": "{{baseUrl}}/api/user-cards/{{userCardId}}/representative"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('본문 없이 204를 반환한다', function () {",
            "  pm.response.to.have.status(204);",
            "  pm.expect(pm.response.text()).to.eql('');",
            "});"
          ] } }]
        },
        {
          "name": "대표카드 조회",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/user-cards/representative" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('설정한 카드가 대표카드 목록에 포함된다', function () {",
            "  pm.response.to.have.status(200);",
            "  const cards = pm.response.json().data.userCards;",
            "  const item = cards.find(card => String(card.userCardId) === pm.collectionVariables.get('userCardId'));",
            "  pm.expect(item).not.to.eql(undefined);",
            "  pm.expect(item.representative).to.eql(true);",
            "});"
          ] } }]
        },
        {
          "name": "카드 삭제",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/user-cards/{{userCardId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('본문 없이 204를 반환한다', function () {",
            "  pm.response.to.have.status(204);",
            "  pm.expect(pm.response.text()).to.eql('');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "04 Notification",
      "item": [
        {
          "name": "알림 목록 조회",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/notifications?page=0&size=10" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('테스트 알림을 조회하고 동적 ID를 캡처한다', function () {",
            "  pm.response.to.have.status(200);",
            "  const data = pm.response.json().data;",
            "  pm.expect(data.notifications).to.be.an('array');",
            "  pm.expect(data.totalCount).to.eql(data.notifications.length);",
            "  pm.expect(data.hasNext).to.be.a('boolean');",
            "  const readItem = data.notifications.find(item => item.title === pm.variables.get('notificationReadTitle'));",
            "  const deleteItem = data.notifications.find(item => item.title === pm.variables.get('notificationDeleteTitle'));",
            "  if (readItem && deleteItem) {",
            "    pm.collectionVariables.set('notificationReadId', String(readItem.notificationId));",
            "    pm.collectionVariables.set('notificationDeleteId', String(deleteItem.notificationId));",
            "  } else {",
            "    pm.collectionVariables.unset('notificationReadId');",
            "    pm.collectionVariables.unset('notificationDeleteId');",
            "    pm.execution.setNextRequest(null);",
            "  }",
            "  pm.expect(readItem).not.to.eql(undefined);",
            "  pm.expect(deleteItem).not.to.eql(undefined);",
            "  pm.expect(readItem.read).to.eql(false);",
            "  pm.expect(Array.isArray(readItem.createdAt)).to.eql(true);",
            "  pm.expect(readItem.createdAt.length).to.be.within(5, 7);",
            "  pm.expect(readItem.createdAt.every(Number.isInteger)).to.eql(true);",
            "});"
          ] } }]
        },
        {
          "name": "알림 읽음 처리",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/api/notifications/{{notificationReadId}}/read" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('본문 없이 204를 반환한다', function () {",
            "  pm.response.to.have.status(204);",
            "  pm.expect(pm.response.text()).to.eql('');",
            "});"
          ] } }]
        },
        {
          "name": "알림 읽음 처리 재호출",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/api/notifications/{{notificationReadId}}/read" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('이미 읽은 알림도 멱등하게 204를 반환한다', function () {",
            "  pm.response.to.have.status(204);",
            "});"
          ] } }]
        },
        {
          "name": "존재하지 않는 알림 읽음 처리",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/api/notifications/0/read" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 NOTIFICATION_NOT_FOUND를 반환한다', function () {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().code).to.eql('NOTIFICATION_NOT_FOUND');",
            "});"
          ] } }]
        },
        {
          "name": "알림 삭제",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/notifications/{{notificationDeleteId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('본문 없이 204를 반환한다', function () {",
            "  pm.response.to.have.status(204);",
            "  pm.expect(pm.response.text()).to.eql('');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "05 Logout",
      "item": [
        {
          "name": "로그아웃",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "refreshToken={{refreshToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Refresh Token을 폐기하고 쿠키를 만료시킨다', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(true);",
            "  const setCookie = pm.response.headers.get('Set-Cookie');",
            "  pm.expect(setCookie).to.include('refreshToken=');",
            "  pm.expect(setCookie).to.include('Max-Age=0');",
            "  pm.expect(setCookie).to.include('HttpOnly');",
            "  pm.expect(setCookie).to.include('Path=/');",
            "  pm.expect(setCookie).to.include('SameSite=Lax');",
            "});"
          ] } }]
        },
        {
          "name": "로그아웃한 Refresh Token 재사용",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "refreshToken={{refreshToken}}" }],
            "url": "{{baseUrl}}/api/auth/token"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 REFRESH_TOKEN_FAILED를 반환한다', function () {",
            "  pm.response.to.have.status(401);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(false);",
            "  pm.expect(body.code).to.eql('REFRESH_TOKEN_FAILED');",
            "});"
          ] } }]
        }
      ]
    }
  ]
}

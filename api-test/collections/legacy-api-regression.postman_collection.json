          "request": {
            "auth": { "type": "noauth" },
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Access-Control-Request-Method", "value": "GET" },
              { "key": "Access-Control-Request-Headers", "value": "Authorization, Content-Type" }
            ],
            "url": "{{baseUrl}}/api/terms"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('현재 동작 기준선 / 변경 근거 문서 없음: 허용 Origin preflight 계약을 유지한다', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.text()).to.eql('');",
            "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173');",
            "  const methods = pm.response.headers.get('Access-Control-Allow-Methods').split(',').map(value => value.trim());",
            "  pm.expect(methods).to.eql(['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS']);",
            "  const headers = pm.response.headers.get('Access-Control-Allow-Headers').split(',').map(value => value.trim()).sort();",
            "  pm.expect(headers).to.eql(['Authorization', 'Content-Type'].sort());",
            "  pm.expect(pm.response.headers.get('Access-Control-Allow-Credentials')).to.eql('true');",
            "  pm.expect(pm.response.headers.get('Access-Control-Max-Age')).to.eql('1800');",
            "});"
          ] } }]

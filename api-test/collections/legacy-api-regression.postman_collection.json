    {
      "name": "05 Logout",
      "item": [
        {
          "name": "로그아웃",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "refreshToken={{refreshToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Refresh Token을 폐기하고 쿠키를 만료시킨다', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(true);",
            "  const setCookie = pm.response.headers.get('Set-Cookie');",
            "  pm.expect(setCookie).to.include('refreshToken=');",
            "  pm.expect(setCookie).to.include('Max-Age=0');",
            "  pm.expect(setCookie).to.include('HttpOnly');",
            "  pm.expect(setCookie).to.include('Path=/');",
            "  pm.expect(setCookie).to.include('SameSite=Lax');",
            "});"
          ] } }]
        },
        {
          "name": "로그아웃한 Refresh Token 재사용",
          "request": {
            "auth": { "type": "noauth" },
